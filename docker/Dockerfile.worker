FROM shipproof-worker-adversarial:disposable

USER root

# Install Node.js runtime and npm
RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Install Kane CLI matching host version 0.10.4
RUN npm install -g @testmuai/kane-cli@0.10.4 && \
    npm cache clean --force

# Set Chromium environment variables for Kane CLI
ENV CHROME_PATH=/usr/bin/chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /workspace
